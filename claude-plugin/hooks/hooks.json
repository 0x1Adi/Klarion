{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "klarion hook --event pre-tool-use",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "klarion hook --event pre-tool-use --bash",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
